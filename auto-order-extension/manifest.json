{
  "manifest_version": 3,
  "name": "ELMS Auto Order",
  "version": "1.3.0",
  "description": "Automatically places the matching Amazon order for a paid eBay order, inside your own logged-in Amazon session.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://amazon.co.uk/*",
    "https://www.amazon.ca/*",
    "https://amazon.ca/*",
    "https://www.amazon.de/*",
    "https://amazon.de/*",
    "https://www.amazon.fr/*",
    "https://amazon.fr/*",
    "https://www.amazon.it/*",
    "https://amazon.it/*",
    "https://www.amazon.es/*",
    "https://amazon.es/*",
    "https://www.amazon.in/*",
    "https://amazon.in/*",
    "https://www.amazon.com.au/*",
    "https://amazon.com.au/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://elms-backend-1-tr5h.onrender.com/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://amazon.co.uk/*",
        "https://www.amazon.ca/*",
        "https://amazon.ca/*",
        "https://www.amazon.de/*",
        "https://amazon.de/*",
        "https://www.amazon.fr/*",
        "https://amazon.fr/*",
        "https://www.amazon.it/*",
        "https://amazon.it/*",
        "https://www.amazon.es/*",
        "https://amazon.es/*",
        "https://www.amazon.in/*",
        "https://amazon.in/*",
        "https://www.amazon.com.au/*",
        "https://amazon.com.au/*"
      ],
      "js": [
        "amazon-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
