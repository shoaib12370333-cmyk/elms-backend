# ---- Core ----
PORT=3000
NODE_ENV=development
MONGODB_URI=
# Long random string (32+ chars) used to sign session tokens (JWT).
JWT_SECRET=
# Long random string (32+ chars) used to encrypt stored secrets (eBay
# refresh tokens, extension keys) at rest, via services/cryptoService.js.
ENCRYPTION_KEY=
# Public URL of the deployed frontend (used for CORS and OAuth redirects).
FRONTEND_URL=
# Extra allowed CORS origins, comma-separated (e.g. a custom domain).
ALLOWED_ORIGINS=

# ---- Google Sign-In ----
GOOGLE_CLIENT_ID=

# ---- Amazon product data (Canopy API) ----
CANOPY_API_KEY=

# ---- eBay ----
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The redirect "RuName" from developer.ebay.com > User Tokens.
EBAY_RU_NAME=
# "production" (default) or "sandbox" - see config/ebayEnvironment.js.
# IMPORTANT: EBAY_CLIENT_ID / EBAY_CLIENT_SECRET / EBAY_RU_NAME above must
# be the matching Sandbox keyset (from developer.ebay.com > Application
# Keys > Sandbox tab) whenever this is set to "sandbox" - a production
# keyset will not work against the sandbox environment, and vice versa.
EBAY_ENV=production
# Set to true only after the eBay Notification API subscription and public HTTPS endpoint are configured.
EBAY_REALTIME_NOTIFICATIONS_ENABLED=false

# eBay Marketplace Account Deletion notification endpoint (required by the
# eBay Developer Program once your app is live).
EBAY_ACCOUNT_DELETION_ENDPOINT_URL=
EBAY_ACCOUNT_DELETION_VERIFICATION_TOKEN=

# eBay real-time order notification endpoint (Commerce Notification API,
# ORDER_CONFIRMATION topic).
EBAY_ORDER_NOTIFICATION_ENDPOINT_URL=
EBAY_ORDER_NOTIFICATION_VERIFICATION_TOKEN=

# ---- Paddle (credit purchases) ----
PADDLE_API_KEY=
# "sandbox" or "production".
PADDLE_ENV=sandbox
PADDLE_WEBHOOK_SECRET=

# ---- One-time admin setup ----
# Used once by POST /api/seed-admin to promote your first user to admin.
# This route refuses to run again once any admin already exists - see
# routes/seedAdmin.js - so it's safe to leave this set, but you can also
# remove it after your first admin is created for extra safety.
SEED_ADMIN_KEY=

# ---- Optional ----
# Emergency fallback Chrome extension ID for CORS. Normally set the
# published extension ID from the Admin Panel (Settings > Chrome
# Extension) instead - this env var is only a fallback for before that's
# configured.
ELMS_EXTENSION_ID=
